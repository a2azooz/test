# =============================================================================
# Football News AI Digest — n8n workflow environment variables
# =============================================================================
# Copy this file to `.env` (self-hosted n8n) and fill in real values, or set
# these as environment variables on whatever platform runs your n8n instance
# (Docker, docker-compose, systemd, Railway, Render, etc.).
#
# NONE of these values are ever written into the workflow JSON. The OpenAI
# and Telegram API keys live in n8n's encrypted credential store (created
# once in the UI); TELEGRAM_CHAT_ID is read at runtime via the n8n
# expression `{{ $env.TELEGRAM_CHAT_ID }}`.
# =============================================================================

# --- OpenAI -------------------------------------------------------------
# Used when you create the "OpenAI account" credential in n8n
# (Credentials > New > OpenAI). n8n stores the key encrypted; it is not
# read from this env var automatically, this file is just for your own
# reference / secrets manager.
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_API_KEY

# --- Telegram -------------------------------------------------------------
# Bot token from @BotFather. Used when you create the "Telegram account"
# credential in n8n (Credentials > New > Telegram API).
TELEGRAM_TOKEN=REPLACE_WITH_YOUR_TELEGRAM_BOT_TOKEN

# The chat ID (or channel/group ID) that should receive the digest.
# The workflow reads this directly at runtime via {{ $env.TELEGRAM_CHAT_ID }}
# so it MUST be set as a real environment variable on the n8n instance
# (not just in n8n's credential store). Find your chat ID by messaging
# @get_id_bot on Telegram, or by calling the Bot API's getUpdates endpoint.
TELEGRAM_CHAT_ID=REPLACE_WITH_YOUR_TELEGRAM_CHAT_ID

# =============================================================================
# n8n instance setting required for TELEGRAM_CHAT_ID to be readable via
# expressions ({{ $env.* }}). This is an n8n server env var, not a workflow
# secret — set it alongside the variables above.
# =============================================================================
# N8N_BLOCK_ENV_ACCESS_IN_NODE=false
