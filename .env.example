# =============================================================================
# Football News AI Digest — n8n workflow secrets reference
# =============================================================================
# This file is NOT loaded automatically by n8n or the workflow — it's a
# reference for the values you'll enter into n8n's UI in the next steps.
# NONE of these values are ever written into the workflow JSON.
# =============================================================================

# --- OpenAI -------------------------------------------------------------
# Used when you create the "OpenAI account" credential in n8n
# (Credentials > New > OpenAI API). n8n stores the key encrypted.
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_API_KEY

# --- Telegram -------------------------------------------------------------
# Bot token from @BotFather. Used when you create the "Telegram account"
# credential in n8n (Credentials > New > Telegram API).
TELEGRAM_TOKEN=REPLACE_WITH_YOUR_TELEGRAM_BOT_TOKEN

# The chat ID (or channel/group ID) that should receive the digest.
#
# IMPORTANT: this is NOT read as a process environment variable. n8n Cloud
# blocks {{ $env.* }} access in expressions for security (and self-hosted
# admins may block it too). Two options, in order of preference:
#
#   1) If your n8n plan has Settings -> Variables: add a Variable with
#      key TELEGRAM_CHAT_ID and this value, then use
#      {{ $vars.TELEGRAM_CHAT_ID }} in the chatId field of both Telegram
#      nodes. Works on Cloud and self-hosted.
#
#   2) If Variables isn't available on your plan: just paste the numeric
#      value below directly into the chatId field of both Telegram nodes.
#      A chat ID is a destination identifier, not a secret -- the bot
#      token above is what actually needs protecting, and it stays in
#      the credential either way.
#
# Find your chat ID the easy way: message @userinfobot on Telegram, it
# replies instantly with your numeric user ID (same ID as your private
# chat with any bot you've started, including your own).
TELEGRAM_CHAT_ID=REPLACE_WITH_YOUR_TELEGRAM_CHAT_ID

# NEVER paste a bot token into a workflow node's "Notes" field or into any
# chat/AI assistant transcript -- Notes are stored in plain text as part of
# the workflow. If this happens by accident, remove it immediately and
# rotate the token via @BotFather in Telegram.
